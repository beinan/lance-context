+/// Cache owners must remain distinct after an engine is dropped and its memory
+/// address or directory name is reused. Allocated once per engine/purge owner;
+/// no atomics or allocations are added to a cache hit.
+pub(crate) fn next_read_cache_id() -> u64 {
+    static NEXT: AtomicU64 = AtomicU64::new(1);
+    NEXT.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |id| id.checked_add(1))
+        .expect("read cache identity exhausted")
+}
